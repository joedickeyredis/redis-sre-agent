# Redis SRE Agent Configuration
# Copy this file to config.yaml and customize for your environment.
#
# Settings can be loaded from (priority order):
#   1. Environment variables (highest priority)
#   2. .env file
#   3. config.yaml (this file)
#   4. Default values (lowest priority)
#
# Set SRE_AGENT_CONFIG environment variable to use a custom path.

# Application settings
# debug: false
# log_level: INFO

# Server settings
# host: "0.0.0.0"
# port: 8000

# OpenAI API Configuration
# openai_api_key: your_openai_api_key_here
# openai_base_url: https://your-llm-proxy.example.com/v1  # Optional: Custom API endpoint for LLM proxy
# openai_model: gpt-4
# openai_model_mini: gpt-4o-mini
# openai_model_nano: gpt-4o-nano

# MCP (Model Context Protocol) servers configuration
# No MCP servers are enabled by default.
# Add the integrations you want to use here.
mcp_servers:
  # GitHub MCP server for repository operations (Docker image)
  github:
    command: docker
    args:
      - run
      - -i
      - --rm
      - -e
      - GITHUB_PERSONAL_ACCESS_TOKEN
      - ghcr.io/github/github-mcp-server
    env:
      # Set your GitHub Personal Access Token here or via environment variable
      GITHUB_PERSONAL_ACCESS_TOKEN: ${GITHUB_PERSONAL_ACCESS_TOKEN}
    # Optionally constrain to search/read tools only with capability categories
    tools:
      search_code:
        capability: repos
      search_issues:
        capability: tickets
      search_pull_requests:
        capability: repos
      get_file_contents:
        capability: repos
      list_issues:
        capability: tickets
      list_pull_requests:
        capability: repos
      issue_read:
        capability: tickets
      pull_request_read:
        capability: repos
      list_commits:
        capability: repos
      get_commit:
        capability: repos
  # Atlassian MCP server for Confluence knowledge base search
  # Remote streamable-HTTP transport with non-interactive API-token (Basic) auth.
  # ATLASSIAN_MCP_BASIC_AUTH = base64("email:api_token"); set it in .env.
  # The token must have Confluence read + search scopes, or tools/list returns
  # only the getTeamworkGraph* tools. No `tools:` block = expose the full
  # tools/list (add a read whitelist before running agent queries).
  atlassian_rovo_mcp:
    url: "https://mcp.atlassian.com/v1/mcp"
    headers:
      Authorization: "Basic ${ATLASSIAN_MCP_BASIC_AUTH}"
    transport: streamable_http
    # Read whitelist: only these 4 search/fetch tools are exposed to the agent.
    # Every Atlassian write tool (createConfluencePage, updateConfluencePage,
    # createJiraIssue, editJiraIssue, transitionJiraIssue, ...) is filtered out.
    # capability: knowledge -> surfaces them under the knowledge category and
    # makes them default to read (auto-allow, no approval prompts).
    # arg_defaults.cloudId is pinned from ATLASSIAN_CLOUD_ID (.env). When it resolves
    # to a concrete value, cloudId is stripped from the tool's advertised schema (so the
    # model never sees it and won't stall asking the user for it) and injected at call
    # time, so cloudId is set on every call.
    tools:
      # Description overrides use {original} to keep the upstream schema/guidance and
      # prepend topical identity: these tools are an additional Redis SRE knowledge
      # source (internal Confluence), so the model treats them as peers of the built-in
      # knowledge base for runbook/documentation questions instead of generic Atlassian
      # search. Branding lives here (not in the system prompt) to keep the prompt
      # provider-agnostic and extensible.
      searchAtlassian:
        capability: knowledge
        action_kind: read
        description: "Search the Redis SRE team's internal Confluence knowledge base (runbooks, incident write-ups, and internal documentation). Consult this alongside the built-in general knowledge base for any documentation, runbook, or troubleshooting question - it holds different content. Use plain natural-language queries; do NOT use search operators (e.g. issue:, type:, site:, AND/OR, field filters) - they are ignored by this tool. {original}"
        arg_defaults:
          cloudId: ${ATLASSIAN_CLOUD_ID}
        # searchAtlassian has no server-side type/limit control and spans all Atlassian
        # products, so a docs query returns many mixed, low-signal hits (Jira issues,
        # CVEs). Keep only Confluence documents (type page/blogpost) and cap at 8 -
        # applied before results reach the LLM context or citations. result_shaping is
        # generic: any MCP search tool can use it.
        result_shaping:
          include_types: [page, blogpost]
          max_results: 8
      fetchAtlassian:
        capability: knowledge
        action_kind: read
        description: "{original} Use this to read complete internal Redis SRE documentation."
        arg_defaults:
          cloudId: ${ATLASSIAN_CLOUD_ID}
      searchConfluenceUsingCql:
        capability: knowledge
        action_kind: read
        # Topical identity + soft nudge (not a hard cap): {original} keeps the upstream
        # description and leaves `limit` in the schema so the model still chooses a count;
        # we only steer it toward a practical page size for the search-then-fetch pattern.
        description: "Search the Redis SRE team's internal Confluence knowledge base (runbooks, incident write-ups, internal docs) using CQL. Consult this alongside the built-in general knowledge base for documentation and troubleshooting questions. Prefer a small limit (about 10, at most 25) since this is search-then-fetch: use the results to locate candidate pages, then read full content with getConfluencePage. {original}"
        arg_defaults:
          cloudId: ${ATLASSIAN_CLOUD_ID}
      getConfluencePage:
        capability: knowledge
        action_kind: read
        description: "{original} Use this to read complete internal Redis SRE documentation."
        arg_defaults:
          cloudId: ${ATLASSIAN_CLOUD_ID}

# Manually overriding tool providers configuration (fully qualified class paths).
# Useful to disable some built-in tool providers and/or enable your own custom providers.
# For more on custom tool providers, see: https://redis-applied-ai.github.io/redis-sre-agent/how-to/tool-providers/#create-a-custom-provider
# tool_providers:
#   - redis_sre_agent.tools.metrics.prometheus.provider.PrometheusToolProvider
#   - redis_sre_agent.tools.diagnostics.redis_command.provider.RedisCommandToolProvider
#   - redis_sre_agent.tools.logs.loki.provider.LokiToolProvider
#   - redis_sre_agent.tools.host_telemetry.provider.HostTelemetryToolProvider

# Skill backend configuration
# Leave these unset to use the shipped Redis-backed skill index.
# To use a custom skill backend, provide its import path. The class may expose
# from_settings(config), accept config=..., accept config as its first argument, or take no args.
#
# skill_backend_kind: custom
# skill_backend_class: my_company.skills.backend.CompanySkillBackend
# skill_reference_char_budget: 12000
